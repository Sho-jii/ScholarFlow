# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Connection
DATABASE_PASSWORD=your_database_password
JWT_SIGNING_KEY=your_jwt_signing_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Model Routing: gemini-3.1-flash-lite (fast, 500 RPD) + gemini-3.5-flash-lite (deep analysis, 500 RPD)
FAST_MODEL=gemini-3.1-flash-lite
DEEP_ANALYSIS_MODEL=gemini-3.5-flash-lite

# Local Mock Mode (Set to 'true' during UI styling to preserve Gemini daily quota)
MOCK_AI_RESPONSES=false

# Cloudflare AI Gateway (Optional)
CLOUDFLARE_AI_GATEWAY_URL=

# Cloudflare Turnstile Bot Protection (Optional toggle)
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
